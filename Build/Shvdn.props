<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned ScriptHookVDotNet reference binaries (not stored in git).
  Restored into $(RepoRoot).shvdn\<ShvdnTarget>\<ShvdnTag>\ during build (Build/Shvdn.targets).

  Update pin: tools/update-shvdn.ps1 -Target Enhanced|Nightly -Tag <release-tag>
  Nightly: pin a scripthookvdotnet-nightly release before building ShvdnTarget=Nightly.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <ShvdnCacheRoot>$(RepoRoot).shvdn\</ShvdnCacheRoot>
    <!-- Default variant when the project does not set ShvdnTarget (GunshotWound2 sets it from Configuration). -->
    <ShvdnTarget Condition="'$(ShvdnTarget)' == ''">Enhanced</ShvdnTarget>
  </PropertyGroup>

  <!-- SHVDN Enhanced (Chiheb-Bacha / SHVDNE) -->
  <PropertyGroup Label="SHVDN Enhanced">
    <ShvdnEnhancedTag>v1.1.0.6</ShvdnEnhancedTag>
    <ShvdnEnhancedZipName>ScriptHookVDotNetEnhanced-$(ShvdnEnhancedTag).zip</ShvdnEnhancedZipName>
    <ShvdnEnhancedDownloadUrl>https://github.com/Chiheb-Bacha/ScriptHookVDotNetEnhanced/releases/download/$(ShvdnEnhancedTag)/$(ShvdnEnhancedZipName)</ShvdnEnhancedDownloadUrl>
    <!-- GitHub release asset digest (ScriptHookVDotNetEnhanced-v1.1.0.6.zip) -->
    <ShvdnEnhancedSha256>f10da8819fa6814fb0a04553567d2516934eac96b16af06ad8f315f0da00473a</ShvdnEnhancedSha256>
    <ShvdnEnhancedReleasePage>https://github.com/Chiheb-Bacha/ScriptHookVDotNetEnhanced/releases/tag/$(ShvdnEnhancedTag)</ShvdnEnhancedReleasePage>
  </PropertyGroup>

  <!-- SHVDN Nightly (upstream crosire — scripthookvdotnet-nightly). Not pinned yet; set tag + SHA256 before Nightly builds. -->
  <PropertyGroup Label="SHVDN Nightly">
    <ShvdnNightlyTag>v3.7.0-nightly.201</ShvdnNightlyTag>
    <ShvdnNightlyZipName>ScriptHookVDotNet-$(ShvdnNightlyTag).zip</ShvdnNightlyZipName>
    <ShvdnNightlyDownloadUrl>https://github.com/scripthookvdotnet/scripthookvdotnet-nightly/releases/download/$(ShvdnNightlyTag)/$(ShvdnNightlyZipName)</ShvdnNightlyDownloadUrl>
    <ShvdnNightlySha256>4f09269d3f19f2aa99ef14f5ecacacea6a899f9bb168999e31cca85748d9ff60</ShvdnNightlySha256>
    <ShvdnNightlyReleasePage>https://github.com/scripthookvdotnet/scripthookvdotnet-nightly/releases/tag/$(ShvdnNightlyTag)</ShvdnNightlyReleasePage>
  </PropertyGroup>

  <!-- Active variant (selected by ShvdnTarget) -->
  <PropertyGroup Condition="'$(ShvdnTarget)' == 'Enhanced'">
    <ShvdnTag>$(ShvdnEnhancedTag)</ShvdnTag>
    <ShvdnZipName>$(ShvdnEnhancedZipName)</ShvdnZipName>
    <ShvdnDownloadUrl>$(ShvdnEnhancedDownloadUrl)</ShvdnDownloadUrl>
    <ShvdnSha256>$(ShvdnEnhancedSha256)</ShvdnSha256>
    <ShvdnReleasePage>$(ShvdnEnhancedReleasePage)</ShvdnReleasePage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ShvdnTarget)' == 'Nightly'">
    <ShvdnTag>$(ShvdnNightlyTag)</ShvdnTag>
    <ShvdnZipName>$(ShvdnNightlyZipName)</ShvdnZipName>
    <ShvdnDownloadUrl>$(ShvdnNightlyDownloadUrl)</ShvdnDownloadUrl>
    <ShvdnSha256>$(ShvdnNightlySha256)</ShvdnSha256>
    <ShvdnReleasePage>$(ShvdnNightlyReleasePage)</ShvdnReleasePage>
  </PropertyGroup>

  <PropertyGroup>
    <ShvdnDir>$(ShvdnCacheRoot)$(ShvdnTarget)\$(ShvdnTag)\</ShvdnDir>
    <ShvdnScriptDll>$(ShvdnDir)ScriptHookVDotNet3.dll</ShvdnScriptDll>
  </PropertyGroup>

  <!-- Loader .asi (game root); API reference for ScriptHookVDotNet.csproj reference -->
  <PropertyGroup Condition="'$(ShvdnTarget)' == 'Enhanced'">
    <ShvdnAsi>$(ShvdnDir)ScriptHookVDotNet.asi</ShvdnAsi>
    <ShvdnApiReference>$(ShvdnDir)ScriptHookVDotNet.asi</ShvdnApiReference>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ShvdnTarget)' == 'Nightly'">
    <ShvdnAsi>$(ShvdnDir)ScriptHookVDotNet-Loader.asi</ShvdnAsi>
    <ShvdnApiReference>$(ShvdnDir)ScriptHookVDotNet.dll</ShvdnApiReference>
  </PropertyGroup>
</Project>
