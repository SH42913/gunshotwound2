<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to Build/Deploy.props.user (gitignored) and adjust paths for your machine.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- GTA V Enhanced (SHVDN Enhanced builds: Debug / Release) -->
    <GtaGameDir_Enhanced>C:\Program Files (x86)\Steam\steamapps\common\Grand Theft Auto V Enhanced</GtaGameDir_Enhanced>
    <!-- GTA V (Debug_Nightly / Release_Nightly; classic / SHVDN nightly) -->
    <GtaGameDir_Nightly>C:\Program Files (x86)\Steam\steamapps\common\Grand Theft Auto V</GtaGameDir_Nightly>
  </PropertyGroup>
</Project>
