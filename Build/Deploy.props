<?xml version="1.0" encoding="utf-8"?>
<!--
  Local GTA V install roots (per SHVDN variant). Not committed — override in Build/Deploy.props.user
  or via environment variables GSW2_GTA_DIR_ENHANCED / GSW2_GTA_DIR_NIGHTLY (optional GSW2_GTA_DIR).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <GtaGameDir_Enhanced Condition="'$(GtaGameDir_Enhanced)' == '' and '$(GSW2_GTA_DIR_ENHANCED)' != ''">$(GSW2_GTA_DIR_ENHANCED)</GtaGameDir_Enhanced>
    <GtaGameDir_Nightly Condition="'$(GtaGameDir_Nightly)' == '' and '$(GSW2_GTA_DIR_NIGHTLY)' != ''">$(GSW2_GTA_DIR_NIGHTLY)</GtaGameDir_Nightly>
    <GtaGameDir_Enhanced Condition="'$(GtaGameDir_Enhanced)' == '' and '$(GSW2_GTA_DIR)' != ''">$(GSW2_GTA_DIR)</GtaGameDir_Enhanced>
    <GtaGameDir_Nightly Condition="'$(GtaGameDir_Nightly)' == '' and '$(GSW2_GTA_DIR)' != ''">$(GSW2_GTA_DIR)</GtaGameDir_Nightly>
  </PropertyGroup>
</Project>
