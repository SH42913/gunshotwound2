    <HitNotification Enabled="TRUE"/>
    <!-- Notification that appears when you hit somebody, show which body part you hit and wound -->

    <CantDetectWeaponNotification Enabled="TRUE"/>
    <!-- Error notification when GSW2 can't detect weapon by damage -->

    <Info Value="TRUE"/>
    <!-- Info notifications: Totally healed, Picked up items, etc -->

    <OtherPeds Value="TRUE"/>
    <!-- Notifications about other peds like "He coughs up blood" -->

    <Wounds Value="TRUE"/>
    <!-- Notifications about player's wounds -->

    <Critical Value="TRUE"/>
    <!-- Important notifications about traumas, heavy wounds, armor penetration, etc -->
</Notifications>