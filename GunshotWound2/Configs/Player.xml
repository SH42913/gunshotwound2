<?xml version="1.0" encoding="utf-8"?>
<PlayerConfig>
    <UseVanillaHealthSystem Value="FALSE"/>
    <!-- If you want to use default health system for player, set this value to TRUE -->
    
    <PoliceCanForget Value="TRUE"/>
    <!-- If TRUE - cops can forget you when you fall unconscious.
    If you use Realism Dispatch Enhanced, better to set it FALSE-->

    <PedsWillIgnoreUnconsciousPlayer Value="TRUE"/>
    <!-- If TRUE - peds will not attack player while he's unconscious -->

    <CanDropWeapon Value="FALSE"/>
    <!-- If TRUE - player will lose a weapon on arm injury or when fall unconscious.
    Recommended to use with Pickups mod. -->

    <HeadshotBehaviour Value="Realistic"/>
    <!-- Realistic: head hits never force instant kill — death comes from wounds and bleeding.
         InstantDeath: first head hit kills immediately.
         SecondHitDeath: instant kill only on the next Head trauma while head injury is active. -->

    <RealisticSpineDamage Value="TRUE"/>
    <!-- If TRUE - player will set to permanent ragdoll on spine damage.
    If FALSE - player will get legs and arms critical damage instead of permanent ragdoll. -->

    <PainSlowMo Value="-1"/>
    <!-- Adrenaline effect that slowdown time using player's pain.
    0.7 means TimeScale never be less than 70% of default time speed. 
    TimeScale will be calculated as 0.7 + painPercent(pain/maxPain).
    Be carefully, it will disable other SlowMo-mods.
    If you want to disable this option, set any negative value. -->

    <UseScreenEffects Value="TRUE"/>
    <!-- Use PostFX screen effects for more immersive experience.
    If you feel nausea or effects annoy you, set value to FALSE. -->

    <AimShakingMult Value="1.0"/>
    <!-- Multiplier for aim camera shaking when player have pain or arm trauma -->

    <PainShockThreshold Value="100.0"/>
    <!-- 100.0 means when pain will more than 100 player will fall unconscious -->

    <PainRecoverySpeed Value="1.5"/>
    <!-- 1.5 means 1.5 pain points will be restored per 1 sec -->

    <BleedHealSpeed Value="0.1"/>
    <!-- How quickly bleeding will heal by itself -->

    <SelfHealingRate Value="0.04"/>
    <!-- How fast you will heal if you have no bleeding -->

    <HelmetCost Value="40"/>
    <!-- 40 means you need $40 to buy a helmet. If you're using a skin changer, you need to set it to 0. -->

    <RampagePainMult Value="0.5"/>
    <!-- 0.5 means you will receive only 50% of pain while you're in Rampage. -->
</PlayerConfig>